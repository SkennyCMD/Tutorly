{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run build:css && node src/index.js",
    "dev": "concurrently -n css,server -c yellow,cyan \"npm:watch:css\" \"nodemon src/index.js\"",
    "https": "npm run build:css && USE_HTTPS=true node src/index.js",
    "dev:https": "concurrently -n css,server -c yellow,cyan \"npm:watch:css\" \"USE_HTTPS=true nodemon src/index.js\"",
    "build:css": "tailwindcss -i ./css-src/tailwind.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css-src/tailwind.css -o ./public/css/tailwind.css --watch",
    "postinstall": "npm run build:css",
    "generate-cert": "bash generate-ssl-cert.sh",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "Matteo Schintu (Skenny)",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "marked": "^15.0.12",
    "node-cron": "^3.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jest": "^30.5.1",
    "nock": "^14.0.17",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  }
}
