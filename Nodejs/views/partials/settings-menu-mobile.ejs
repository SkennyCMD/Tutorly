<!-- Mobile sidebar settings menu: a full-width gear row that expands an
     inline submenu (accordion, not an absolute popup - the sidebar already
     scrolls in its own flow) containing the theme toggle, push-notification
     toggle, and logout rows. Included on every page that has this mobile
     menu (home, calendar, lessons, reports, staffPanel, student).
     Open/close wiring lives in public/js/settingsMenu.js
     (#settingsMenuBtnMobile/#settingsMenuMobile). -->
<button type="button" id="settingsMenuBtnMobile"
  class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors"
  aria-haspopup="true" aria-expanded="false">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
  </svg>
  <span><%= t('common.settings') %></span>
</button>
<div id="settingsMenuMobile" class="hidden flex flex-col gap-1 pl-4 mt-1">
  <%- include('theme-toggle-mobile') %>
  <%- include('push-toggle-mobile') %>
  <div class="border-t border-border my-1"></div>
  <form action="/logout" method="POST">
    <button type="submit"
      class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-secondary transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <%= t('common.logout') %>
    </button>
  </form>
</div>
