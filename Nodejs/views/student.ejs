<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tutorly - Student Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/student.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: '#0a0a0a',
            foreground: '#fafafa',
            card: '#141414',
            'card-foreground': '#fafafa',
            primary: '#14b8a6',
            'primary-foreground': '#0a0a0a',
            secondary: '#262626',
            'secondary-foreground': '#fafafa',
            muted: '#262626',
            'muted-foreground': '#a1a1aa',
            border: '#2e2e2e',
            ring: '#14b8a6',
            destructive: '#ef4444',
          }
        }
      }
    }
  </script>
</head>
<body class="bg-background text-foreground min-h-screen">

  <!-- Header -->
  <header class="bg-card border-b border-border sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/home" class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-foreground">Tutorly</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/home" class="text-muted-foreground hover:text-foreground transition-colors">Dashboard</a>
          <a href="/calendar" class="text-muted-foreground hover:text-foreground transition-colors">Calendar</a>
          <a href="/lessons" class="text-muted-foreground hover:text-foreground transition-colors">My Lessons</a>
          <a href="/reports" class="text-muted-foreground hover:text-foreground transition-colors">Reports</a>
          <!-- STAFF role-based link to Staff Panel -->
          <% if (user && user.role==='STAFF' ) { %>
            <a href="/staffPanel" class="text-muted-foreground hover:text-foreground transition-colors">Staff Panel</a>
            <% } %>
        </nav>

        <!-- Logout form button (Desktop) -->
        <div class="hidden md:flex items-center gap-1">
          <form action="/logout" method="POST" class="inline">
            <button type="submit"
              class="flex items-center gap-2 px-3 py-2 text-muted-foreground hover:text-foreground hover:bg-secondary rounded-lg transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span class="text-sm font-medium">Logout</span>
            </button>
          </form>
        </div>

        <!-- Mobile Menu Button -->
        <button id="menuToggle" class="md:hidden p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu Overlay -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Mobile Sidebar Menu -->
  <aside id="mobileMenu" class="mobile-menu fixed top-0 left-0 h-full w-72 bg-card border-r border-border z-50 md:hidden">
    <div class="p-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
          </svg>
        </div>
        <span class="text-lg font-bold text-foreground">Tutorly</span>
      </div>
      <button id="closeMenu" class="p-2 rounded-lg hover:bg-secondary transition-colors">
        <svg class="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="p-4 flex flex-col gap-2">
      <a href="/home" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Dashboard
      </a>
      <a href="/calendar" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Calendar
      </a>
      <a href="/lessons" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        My Lessons
      </a>
      <a href="/reports" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        Reports
      </a>
      <!-- STAFF role-based link in mobile menu -->
      <% if (user && user.role==='STAFF' ) { %>
        <a href="/staffPanel" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          Staff Panel
        </a>
        <% } %>

      <!-- Logout button in mobile menu -->
      <div class="mt-4 pt-4 border-t border-border">
        <form action="/logout" method="POST">
          <button type="submit"
            class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-secondary transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            Logout
          </button>
        </form>
      </div>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

    <!-- Student Profile Header -->
    <div class="bg-card border border-border rounded-xl p-5 sm:p-6 mb-6">
      <div class="flex flex-col sm:flex-row sm:items-center gap-5">
        <div class="w-20 h-20 bg-primary/15 border border-primary/30 rounded-2xl flex items-center justify-center flex-shrink-0">
          <span id="studentInitials" class="text-2xl font-bold text-primary"></span>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-3">
            <h1 id="studentName" class="text-2xl sm:text-3xl font-bold text-foreground"></h1>
            <span id="studentClassBadge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium"></span>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-1 mt-2 text-sm text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span id="studentSurnameLabel"></span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
              </svg>
              <span id="studentClassLabel"></span>
            </span>
          </div>
        </div>
        <!-- Quick stats -->
        <div class="grid grid-cols-3 gap-3 sm:gap-4 w-full sm:w-auto">
          <div class="bg-secondary rounded-lg px-4 py-3 text-center">
            <p id="avgMark" class="text-xl font-bold text-foreground">0</p>
            <p class="text-xs text-muted-foreground mt-0.5">Avg mark</p>
          </div>
          <div class="bg-secondary rounded-lg px-4 py-3 text-center">
            <p id="totalTests" class="text-xl font-bold text-foreground">0</p>
            <p class="text-xs text-muted-foreground mt-0.5">Tests</p>
          </div>
          <div class="bg-secondary rounded-lg px-4 py-3 text-center">
            <p id="totalHours" class="text-xl font-bold text-foreground">0h</p>
            <p class="text-xs text-muted-foreground mt-0.5">Hours</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Left Column: Test marks graph + list -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Test Marks Graph -->
        <div class="bg-card border border-border rounded-xl p-5">
          <div class="flex items-center justify-between mb-5">
            <div>
              <h2 class="text-lg font-semibold text-foreground">Test Marks</h2>
              <p class="text-xs text-muted-foreground mt-0.5">Progress across recent tests</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-muted-foreground">Average</p>
              <p id="chartAvg" class="text-2xl font-bold text-primary">0</p>
            </div>
          </div>
          <div id="marksChart"></div>
          <div class="flex items-center gap-4 mt-4 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-0.5 bg-primary inline-block rounded"></span> Marks
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-0.5 inline-block rounded" style="background:#a1a1aa;border-top:2px dashed #a1a1aa"></span> Running average
            </div>
            <span class="ml-auto">Click a point for details</span>
          </div>
        </div>

        <!-- Marks List -->
        <div class="bg-card border border-border rounded-xl p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-foreground">All Tests</h2>
            <span id="marksCount" class="text-sm text-muted-foreground"></span>
          </div>
          <div id="marksList" class="space-y-2"></div>
        </div>
      </div>

      <!-- Right Column: Hours per month + Calendar -->
      <div class="lg:col-span-1 space-y-6">

        <!-- Hours per Month -->
        <div class="bg-card border border-border rounded-xl p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-foreground">Hours per Month</h2>
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div id="hoursChart" class="space-y-3"></div>
        </div>

        <!-- Mini Calendar -->
        <div class="bg-card border border-border rounded-xl p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-foreground">Lesson Calendar</h2>
            <span class="text-xs text-muted-foreground">Lesson days highlighted</span>
          </div>
          <div class="flex items-center justify-between mb-3">
            <button id="prevMonth" class="p-1.5 rounded-lg hover:bg-secondary transition-colors">
              <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <span id="calendarMonth" class="text-sm font-medium text-foreground"></span>
            <button id="nextMonth" class="p-1.5 rounded-lg hover:bg-secondary transition-colors">
              <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
          <div class="grid grid-cols-7 gap-1 text-center text-xs mb-2">
            <span class="text-muted-foreground py-1">Mo</span>
            <span class="text-muted-foreground py-1">Tu</span>
            <span class="text-muted-foreground py-1">We</span>
            <span class="text-muted-foreground py-1">Th</span>
            <span class="text-muted-foreground py-1">Fr</span>
            <span class="text-muted-foreground py-1">Sa</span>
            <span class="text-muted-foreground py-1">Su</span>
          </div>
          <div id="calendarDays" class="grid grid-cols-7 gap-1 text-center text-sm"></div>
          <div class="flex items-center gap-2 mt-4 text-xs text-muted-foreground">
            <span class="w-3 h-3 rounded bg-primary/30 border border-primary inline-block"></span>
            Day with a lesson
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Test Info Modal -->
  <div id="testInfoModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeTestInfo()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground">Test Details</h2>
        <button onclick="closeTestInfo()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="space-y-4">
        <div class="flex items-center justify-center">
          <div id="infoMarkCircle" class="w-20 h-20 rounded-full flex items-center justify-center border-4">
            <span id="infoMark" class="text-2xl font-bold"></span>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-sm text-muted-foreground">Test ID</span>
            <span id="infoTestId" class="text-sm font-medium text-foreground"></span>
          </div>
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-sm text-muted-foreground">Date</span>
            <span id="infoDate" class="text-sm font-medium text-foreground"></span>
          </div>
          <div class="py-2">
            <span class="text-sm text-muted-foreground block mb-1.5">Description</span>
            <p id="infoDescription" class="text-sm text-foreground"></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/student.js"></script>
</body>
</html>