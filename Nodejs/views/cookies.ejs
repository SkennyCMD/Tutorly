<!--

COOKIE POLICY PAGE

Description: Public page explaining Tutorly's cookie usage - linked from the
login page footer. Not behind authentication (anyone can read it before
signing in).
Features:
  - Explains the single session cookie the app sets (tutorly.sid)
  - States plainly that no third-party/tracking/advertising cookies are used
  - Notes that theme preference is stored in localStorage, not a cookie
  - Same header/footer chrome as login.ejs for visual consistency

-->

<!DOCTYPE html>
<html lang="<%= lang %>">
<!-- HEAD: Page Configuration -->

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('cookies.pageTitle') %></title>
  <%- include('partials/theme-init') %>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <%- include('partials/theme-config') %>
  <script>
    tailwind.config.theme.extend.fontFamily = { sans: ['Inter', 'sans-serif'] };
  </script>
  <%- include('partials/pwa-setup') %>
</head>

<body class="font-sans bg-background min-h-screen flex flex-col">

  <!-- HEADER: same logo/theme-toggle chrome as login.ejs -->
  <header class="w-full py-4 px-6 md:px-12">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="/login" class="flex items-center gap-2">
        <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
          <path d="M6 12v5c3 3 9 3 12 0v-5" />
        </svg>
        <span class="text-xl font-bold text-foreground">Tutorly</span>
        <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
      </a>
      <%- include('partials/theme-toggle') %>
    </div>
  </header>

  <!-- MAIN CONTENT: Cookie policy -->
  <main class="flex-1 flex items-center justify-center px-4 py-8 md:py-12">
    <div class="w-full max-w-2xl">
      <div class="bg-card rounded-2xl shadow-lg shadow-black/5 p-8 md:p-10">
        <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-4"><%= t('cookies.heading') %></h1>
        <p class="text-muted-foreground mb-8"><%= t('cookies.intro') %></p>

        <h2 class="text-sm font-semibold text-foreground uppercase tracking-wide mb-3"><%= t('cookies.tableTitle') %></h2>
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm border border-border rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-secondary text-left text-muted-foreground">
                <th class="px-4 py-2.5 font-medium"><%= t('cookies.colName') %></th>
                <th class="px-4 py-2.5 font-medium"><%= t('cookies.colPurpose') %></th>
                <th class="px-4 py-2.5 font-medium"><%= t('cookies.colType') %></th>
                <th class="px-4 py-2.5 font-medium"><%= t('cookies.colDuration') %></th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-border">
                <td class="px-4 py-3 font-mono text-foreground align-top"><%= t('cookies.sessionCookieName') %></td>
                <td class="px-4 py-3 text-muted-foreground align-top"><%= t('cookies.sessionCookiePurpose') %></td>
                <td class="px-4 py-3 text-muted-foreground align-top"><%= t('cookies.sessionCookieType') %></td>
                <td class="px-4 py-3 text-muted-foreground align-top">
                  <%= t('cookies.sessionCookieDurationTutor') %><br>
                  <%= t('cookies.sessionCookieDurationAdmin') %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="space-y-6">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <h3 class="text-sm font-semibold text-foreground"><%= t('cookies.noThirdParty') %></h3>
              <p class="text-sm text-muted-foreground"><%= t('cookies.noThirdPartyDesc') %></p>
            </div>
          </div>

          <div class="flex gap-3">
            <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <h3 class="text-sm font-semibold text-foreground"><%= t('cookies.noTracking') %></h3>
              <p class="text-sm text-muted-foreground"><%= t('cookies.noTrackingDesc') %></p>
            </div>
          </div>

          <div class="flex gap-3">
            <svg class="w-5 h-5 text-muted-foreground shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
              <h3 class="text-sm font-semibold text-foreground"><%= t('cookies.essential') %></h3>
              <p class="text-sm text-muted-foreground"><%= t('cookies.essentialDesc') %></p>
            </div>
          </div>

          <div class="flex gap-3 pt-4 border-t border-border">
            <svg class="w-5 h-5 text-muted-foreground shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <div>
              <h3 class="text-sm font-semibold text-foreground"><%= t('cookies.otherStorage') %></h3>
              <p class="text-sm text-muted-foreground"><%= t('cookies.otherStorageDesc') %></p>
            </div>
          </div>
        </div>

        <a href="/login" class="inline-flex items-center gap-2 mt-8 text-sm text-primary hover:text-primary-hover transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <%= t('cookies.backToLogin') %>
        </a>
      </div>
    </div>
  </main>

  <!-- FOOTER: same as login.ejs -->
  <footer class="py-6 px-6 border-t border-border">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground"><%= t('login.copyright') %></p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors"><%= t('login.privacy') %></a>
        <a href="/cookies" class="text-sm text-foreground font-medium"><%= t('login.cookies') %></a>
      </div>
    </div>
  </footer>

  <script src="/js/theme.js"></script>
</body>

</html>
