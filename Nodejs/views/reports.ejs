<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tutorly - <%= t('reports.heading') %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/reports.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: '#0a0a0a',
            foreground: '#fafafa',
            card: '#141414',
            'card-foreground': '#fafafa',
            primary: '#14b8a6',
            'primary-foreground': '#0a0a0a',
            secondary: '#262626',
            'secondary-foreground': '#fafafa',
            muted: '#262626',
            'muted-foreground': '#a1a1aa',
            border: '#2e2e2e',
            ring: '#14b8a6',
            destructive: '#ef4444',
          }
        }
      }
    }
  </script>
</head>
<body class="bg-background text-foreground min-h-screen">

  <!-- Header -->
  <header class="bg-card border-b border-border sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/home" class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-foreground">Tutorly</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/home" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.dashboard') %></a>
          <a href="/calendar" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.calendar') %></a>
          <a href="/lessons" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.myLessons') %></a>
          <a href="/reports" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('reports.navLabel') %></a>
          <!-- STAFF role-based link to Staff Panel -->
          <% if (user && user.role==='STAFF' ) { %>
            <a href="/staffPanel" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.staffPanel') %></a>
            <% } %>
        </nav>

        <!-- User Menu (Desktop) -->
        <div class="hidden md:flex items-center gap-4">
          <div class="w-9 h-9 bg-secondary rounded-full flex items-center justify-center">
            <span class="text-sm font-medium text-foreground">JD</span>
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <button id="menuToggle" class="md:hidden p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu Overlay -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Mobile Sidebar Menu -->
  <aside id="mobileMenu" class="mobile-menu fixed top-0 left-0 h-full w-72 bg-card border-r border-border z-50 md:hidden">
    <div class="p-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
          </svg>
        </div>
        <span class="text-lg font-bold text-foreground">Tutorly</span>
      </div>
      <button id="closeMenu" class="p-2 rounded-lg hover:bg-secondary transition-colors">
        <svg class="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="p-4 flex flex-col gap-2">
      <a href="/home" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <%= t('common.dashboard') %>
      </a>
      <a href="/calendar" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <%= t('common.calendar') %>
      </a>
      <a href="/lessons" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <%= t('common.myLessons') %>
      </a>
      <a href="/reports"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <%= t('reports.navLabel') %>
      </a>
      <!-- STAFF role-based link in mobile menu -->
      <% if (user && user.role==='STAFF' ) { %>
        <a href="/staffPanel"
          class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <%= t('common.staffPanel') %>
        </a>
        <% } %>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

    <!-- Page Title -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-foreground"><%= t('reports.heading') %></h1>
        <p class="text-muted-foreground mt-1"><%= t('reports.subtitle') %></p>
      </div>
      <button id="addEvalBtn" class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-4 py-2.5 rounded-lg font-medium hover:bg-primary/90 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <%= t('reports.addEvaluation') %>
      </button>
    </div>

    <!-- Evaluations Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Recent Evaluations (Left) -->
      <div class="lg:col-span-1 bg-card border border-border rounded-xl p-5 h-fit">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-foreground"><%= t('reports.recentEvaluations') %></h2>
          <span id="recentCount" class="text-sm text-muted-foreground"></span>
        </div>
        <div id="recentList" class="space-y-2 max-h-80 overflow-y-auto scrollbar-thin">
          <!-- Recent evaluations rendered here -->
        </div>
      </div>

      <!-- Statistics (Center-Right) -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Date Range Filter -->
        <div class="bg-card border border-border rounded-xl p-5">
          <h2 class="text-lg font-semibold text-foreground mb-4"><%= t('reports.studentStatistics') %></h2>

          <!-- Search Bar: Filter statistics/recent evaluations by student name -->
          <div class="relative w-full mb-4">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none"
              stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" id="searchInput" placeholder="<%= t('reports.searchStudents') %>"
              class="w-full pl-10 pr-4 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>

          <div class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
              <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('reports.from') %></label>
              <input type="date" id="fromDate" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            </div>
            <div class="flex-1 w-full">
              <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('reports.to') %></label>
              <input type="date" id="toDate" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            </div>
            <button id="applyFilter" class="w-full sm:w-auto px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors"><%= t('reports.apply') %></button>
          </div>
        </div>

        <!-- Student Reports Container -->
        <div id="reportsContainer" class="space-y-6">
          <!-- Per-student report cards rendered here -->
        </div>

        <!-- Empty State -->
        <div id="emptyReports" class="hidden bg-card border border-border rounded-xl py-12 text-center">
          <div class="w-16 h-16 bg-secondary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <p class="text-muted-foreground"><%= t('reports.noEvaluationsFound') %></p>
        </div>
      </div>
    </div>
  </main>

  <!-- Add Evaluation Modal -->
  <div id="addEvalModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeEvalModal()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('reports.addEvaluation') %></h2>
        <button onclick="closeEvalModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <form id="evalForm" class="space-y-4">
        <!-- Student search field with autocomplete filtering -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.searchStudent') %></label>
          <input type="text" id="evalStudentSearch" placeholder="<%= t('common.searchByName') %>"
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            autocomplete="off">
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('home.student') %></label>
          <select id="evalStudent" required class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value=""><%= t('common.selectAStudentOption') %></option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('reports.subjectLabel') %></label>
          <select id="evalSubject" required class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value=""><%= t('reports.selectSubjectOption') %></option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('reports.markLabel') %></label>
            <input type="number" id="evalMark" required min="0" max="10" step="0.5" placeholder="8.5" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.date') %></label>
            <input type="date" id="evalDate" required class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.description') %></label>
          <textarea id="evalDescription" rows="3" placeholder="<%= t('reports.testDescriptionPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"></textarea>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="button" onclick="closeEvalModal()" class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
          <button type="submit" class="flex-1 px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors"><%= t('reports.add') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Test Info Modal -->
  <div id="testInfoModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeTestInfo()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('reports.testDetails') %></h2>
        <button onclick="closeTestInfo()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="space-y-4">
        <div class="flex items-center justify-center">
          <div id="infoMarkCircle" class="w-20 h-20 rounded-full flex items-center justify-center border-4">
            <span id="infoMark" class="text-2xl font-bold"></span>
          </div>
        </div>
        <div class="space-y-3">
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-sm text-muted-foreground"><%= t('reports.testIdLabel') %></span>
            <span id="infoTestId" class="text-sm font-medium text-foreground"></span>
          </div>
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-sm text-muted-foreground"><%= t('common.date') %></span>
            <span id="infoDate" class="text-sm font-medium text-foreground"></span>
          </div>
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-sm text-muted-foreground"><%= t('home.student') %></span>
            <span id="infoStudent" class="text-sm font-medium text-foreground"></span>
          </div>
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-sm text-muted-foreground"><%= t('reports.subjectLabel') %></span>
            <span id="infoSubject" class="text-sm font-medium text-foreground"></span>
          </div>
          <div class="py-2">
            <span class="text-sm text-muted-foreground block mb-1.5"><%= t('common.description') %></span>
            <p id="infoDescription" class="text-sm text-foreground"></p>
          </div>
        </div>
        <div class="pt-2">
          <button id="deleteTestBtn" onclick="deleteEvaluation()" class="w-full px-4 py-2.5 bg-destructive text-white rounded-lg font-medium hover:bg-destructive/90 transition-colors"><%= t('common.delete') %></button>
        </div>
      </div>
    </div>
  </div>

    <script>
      // Pass server-rendered data to JavaScript for client-side rendering
      window.initialEvaluations = <%- JSON.stringify(evaluations) %>;
      window.allStudents = <%- JSON.stringify(students) %>;
      window.allSubjects = <%- JSON.stringify(subjects) %>;
      window.translations = <%- JSON.stringify(translations) %>;
      window.lang = <%- JSON.stringify(lang) %>;
    </script>
    <script src="/js/i18n.js"></script>
    <script src="/js/reports.js"></script>
</body>
</html>
