<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tutorly - Dashboard Notes</title>
  <%- include('partials/theme-init') %>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-config') %>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/dashboardNotes.css">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
</head>
<body class="bg-background text-foreground min-h-screen">

  <!-- HEADER: Top Navigation Bar (same structure as admin.ejs) -->
  <header class="bg-card border-b border-border sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo with ADMIN badge -->
        <a href="/admin" class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-foreground">Tutorly</span>
          <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
          <span class="ml-2 text-xs font-medium bg-destructive/20 text-destructive px-2 py-0.5 rounded-full">ADMIN</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/admin" class="text-muted-foreground hover:text-foreground transition-colors">Admin Panel</a>
          <a href="/ticketing" class="text-muted-foreground hover:text-foreground transition-colors">Tickets</a>
          <a href="/dashboardNotes" class="text-foreground font-medium" aria-current="page">Dashboard notes</a>
        </nav>

        <!-- Theme toggle and Logout button (desktop only) -->
        <div class="hidden md:flex items-center gap-1">
          <%- include('partials/theme-toggle') %>
          <a href="/adminLogout" class="text-sm text-muted-foreground hover:text-foreground transition-colors px-2">Logout</a>
        </div>

        <!-- Mobile menu toggle button -->
        <button id="menuToggle" class="md:hidden p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- MOBILE MENU: Overlay and Sidebar -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <aside id="mobileMenu" class="mobile-menu fixed top-0 left-0 h-full w-72 bg-card border-r border-border z-50 md:hidden">
    <div class="p-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            </svg>
        </div>
        <span class="text-lg font-bold text-foreground">Tutorly</span>
        <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
        <span class="text-xs font-medium bg-destructive/20 text-destructive px-2 py-0.5 rounded-full">ADMIN</span>
      </div>
      <button id="closeMenu" class="p-2 rounded-lg hover:bg-secondary transition-colors">
        <svg class="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="p-4 flex flex-col gap-2">
      <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Admin Panel
      </a>
      <a href="/ticketing" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h3.75M9 15h3.75M9 18h3.75m3-15H9a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 009 21h9a2.25 2.25 0 002.25-2.25V9M15 3v4.5A1.5 1.5 0 0016.5 9H21M15 3l6 6" />
        </svg>
        Tickets
      </a>
      <a href="/dashboardNotes" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-secondary text-foreground" aria-current="page">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.067 1.21-.46 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46" />
        </svg>
        Dashboard notes
      </a>

      <!-- Theme toggle and Logout section (separated with border) -->
      <div class="border-t border-border mt-2 pt-2 space-y-1">
        <%- include('partials/theme-toggle-mobile') %>
        <a href="/adminLogout" class="flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-secondary transition-colors">
          Logout
        </a>
      </div>
    </nav>
  </aside>

  <main class="mx-auto max-w-7xl space-y-7 px-4 py-7 sm:px-6 sm:py-9">
    <section><p class="text-sm font-medium uppercase tracking-[.16em] text-primary">Admin tools</p><h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">Dashboard notes</h1><p class="mt-2 max-w-2xl text-sm text-muted-foreground sm:text-base">Create announcements and learning notes with Markdown, and manage when they expire.</p></section>
    <section class="grid items-start gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <form id="noteForm" class="rounded-2xl border border-border bg-card p-5 sm:p-6">
        <div class="mb-5"><h2 class="text-lg font-semibold">Create a dashboard note</h2><p class="mt-1 text-sm text-muted-foreground">Markdown is supported: headings, lists, links, blockquotes, and code.</p></div>
        <label for="noteContent" class="mb-2 block text-sm font-medium">Note content <span class="text-destructive">*</span></label>
        <textarea id="noteContent" name="content" required rows="7" maxlength="2000" placeholder="## This week's focus&#10;&#10;Review **linear equations** and remember:&#10;- Show each step&#10;- Check your answer&#10;&#10;Use `x + 2 = 5` as an example." class="w-full resize-y rounded-lg border border-border bg-secondary px-3 py-3 text-sm leading-6 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
        <p class="mt-2 text-xs text-muted-foreground">Markdown is rendered in the preview and note lists.</p>
        <div class="mt-5"><label for="expiresAt" class="mb-2 block text-sm font-medium">Expiration date <span class="text-destructive">*</span></label><input id="expiresAt" name="expiresAt" type="date" required class="w-full rounded-lg border border-border bg-secondary px-3 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary"><p class="mt-2 text-xs text-muted-foreground">The note remains active through the selected date.</p></div>
        <div class="mt-5 rounded-lg border border-border bg-background p-3"><p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Preview</p><div id="notePreview" class="markdown-note min-h-8 break-words text-sm leading-6" aria-live="polite">Your note preview will appear here.</div></div>
        <button type="submit" class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90 sm:w-auto"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14m-7-7h14"/></svg>Create note</button>
        <p id="formMessage" class="mt-3 text-sm text-primary" role="status" aria-live="polite"></p>
      </form>
      <div class="space-y-6">
        <section aria-labelledby="active-heading" class="space-y-3"><div class="flex items-center justify-between"><div><h2 id="active-heading" class="text-xl font-semibold">Not expired</h2><p class="mt-1 text-sm text-muted-foreground">Notes visible on the dashboard.</p></div><span id="activeCount" class="rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground">0</span></div><div id="activeNotes" class="space-y-3" aria-live="polite"></div></section>
        <section aria-labelledby="expired-heading" class="space-y-3"><div class="flex items-center justify-between"><div><h2 id="expired-heading" class="text-xl font-semibold">Expired</h2><p class="mt-1 text-sm text-muted-foreground">Notes past their expiration date.</p></div><span id="expiredCount" class="rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground">0</span></div><div id="expiredNotes" class="space-y-3" aria-live="polite"></div></section>
      </div>
    </section>
  </main>

  <script>
    // Notes from GET /dashboardNotes (window.initialNotes, see src/index.js).
    // Publishing a new one goes through POST /api/dashboard-notes.
    window.initialNotes = <%- JSON.stringify(notes) %>;
  </script>
  <script src="/js/dashboardNotes.js"></script>
</body>
</html>
