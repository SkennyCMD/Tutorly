<!--
    Admin Panel - Tutorly
    
    Purpose: Administrative dashboard for managing tutors, students, and accounts
    Features:
    - View and search all tutors with role and status management
    - View and search all students with class management
    - Create new tutor accounts with password validation
    - Responsive design with mobile sidebar
    - Real-time search and filtering
    - Confirmation modals for critical actions
    - Toast notifications for user feedback
-->
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <!-- Character encoding and viewport for responsive design -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin.pageTitle') %></title>
  <%- include('partials/theme-init') %>

  <link rel="stylesheet" href="/css/tailwind.css">

  <!-- Custom admin panel styles -->
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-background text-foreground min-h-screen">

  <!-- HEADER -->
  <!-- Sticky header with logo, navigation, and logout -->
  <header class="bg-card border-b border-border sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo with ADMIN badge -->
        <a href="admin.html" class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-foreground">Tutorly</span>
          <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
          <span class="ml-2 text-xs font-medium bg-destructive/20 text-destructive px-2 py-0.5 rounded-full"><%= t('common.admin.badge') %></span>
        </a>

        <!-- Desktop Navigation (commented links are for future features) -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/admin" class="text-foreground font-medium transition-colors"><%= t('common.admin.navPanel') %></a>
          <a href="/ticketing" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.admin.navTickets') %></a>
          <a href="/dashboardNotes" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.admin.navDashboardNotes') %></a>
          <!-- Future features: Staff Management and Reports -->
          <!-- <a href="staff.html" class="text-muted-foreground hover:text-foreground transition-colors">Staff Management</a>
          <a href="reports.html" class="text-muted-foreground hover:text-foreground transition-colors">Reports</a> -->
        </nav>

        <!-- Theme toggle and Logout button (desktop only) -->
        <div class="hidden md:flex items-center gap-1">
          <%- include('partials/theme-toggle') %>
          <a href="/adminLogout" class="text-sm text-muted-foreground hover:text-foreground transition-colors px-2"><%= t('common.logout') %></a>
        </div>

        <!-- Mobile menu toggle button -->
        <button id="menuToggle" class="md:hidden p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- MOBILE MENU -->
  <!-- Overlay - clicking this closes the mobile menu -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Slide-in mobile sidebar -->
  <aside id="mobileMenu" class="mobile-menu fixed top-0 left-0 h-full w-72 bg-card border-r border-border z-50 md:hidden">
    <!-- Mobile menu header with logo and close button -->
    <div class="p-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
          </svg>
        </div>
        <span class="text-lg font-bold text-foreground">Tutorly</span>
        <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
        <span class="text-xs font-medium bg-destructive/20 text-destructive px-2 py-0.5 rounded-full"><%= t('common.admin.badge') %></span>
      </div>
      <button id="closeMenu" class="p-2 rounded-lg hover:bg-secondary transition-colors">
        <svg class="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    
    <!-- Mobile navigation links -->
    <nav class="p-4 flex flex-col gap-2">
      <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-secondary text-foreground">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <%= t('common.admin.navPanel') %>
      </a>
      <a href="/ticketing" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h3.75M9 15h3.75M9 18h3.75m3-15H9a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 009 21h9a2.25 2.25 0 002.25-2.25V9M15 3v4.5A1.5 1.5 0 0016.5 9H21M15 3l6 6"/>
        </svg>
        <%= t('common.admin.navTickets') %>
      </a>
      <a href="/dashboardNotes" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.067 1.21-.46 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46"/>
        </svg>
        <%= t('common.admin.navDashboardNotes') %>
      </a>

      <!-- Future navigation items (commented out) -->
      <!-- <a href="staff.html" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        Staff Management
      </a>
      <a href="reports.html" class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Reports
      </a> -->
      
      <!-- Theme toggle and Logout section (separated with border) -->
      <div class="border-t border-border mt-2 pt-2 space-y-1">
        <%- include('partials/theme-toggle-mobile') %>
        <a href="/adminLogout" class="flex items-center gap-3 px-4 py-3 rounded-lg text-destructive hover:bg-secondary transition-colors">
          <%= t('common.logout') %>
        </a>
      </div>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <!-- Three-column layout: Tutors list | Students list | Create tutor form -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

    <!-- Page header with title and description -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground"><%= t('common.admin.navPanel') %></h1>
      <p class="text-muted-foreground mt-1"><%= t('admin.subtitle') %></p>
    </div>

    <!-- Three-column responsive grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- COLUMN 1: TUTORS LIST -->
      <!-- Displays all tutors with search, role, and status management -->
      <div class="bg-card border border-border rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-foreground"><%= t('admin.tutorsHeading') %></h2>
          <span id="tutorCount" class="text-sm text-muted-foreground"></span>
        </div>

        <!-- Search input for filtering tutors -->
        <div class="mb-4">
          <input type="text" id="tutorSearch" placeholder="<%= t('admin.tutorSearchPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring text-sm">
        </div>

        <!-- Scrollable list of tutors (populated by JavaScript) -->
        <div id="tutorsList" class="space-y-3 max-h-[520px] overflow-y-auto pr-1">
          <!-- Tutor cards will be dynamically inserted here by admin.js -->
        </div>
      </div>

      <!-- COLUMN 2: STUDENTS LIST -->
      <!-- Displays all students with search and class management -->
      <div class="bg-card border border-border rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-foreground"><%= t('admin.studentsHeading') %></h2>
          <span id="studentCount" class="text-sm text-muted-foreground"></span>
        </div>

        <!-- Search input for filtering students -->
        <div class="mb-4">
          <input type="text" id="studentSearch" placeholder="<%= t('admin.studentSearchPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring text-sm">
        </div>

        <!-- Scrollable list of students (populated by JavaScript) -->
        <div id="studentsList" class="space-y-3 max-h-[520px] overflow-y-auto pr-1">
          <!-- Student cards will be dynamically inserted here by admin.js -->
        </div>
      </div>

      <!-- COLUMN 3: CREATE TUTOR FORM -->
      <!-- Form for creating new tutor accounts with validation -->
      <div class="bg-card border border-border rounded-xl p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4"><%= t('admin.createTutorHeading') %></h2>

        <form id="createTutorForm" class="space-y-4">
          <!-- Username input -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.usernameLabel') %></label>
            <input type="text" id="newUsername" required placeholder="<%= t('admin.usernamePlaceholderTutor') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>

          <!-- Password input with visibility toggle -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.passwordLabel') %></label>
            <div class="relative">
              <input type="password" id="newPassword" required placeholder="<%= t('admin.passwordPlaceholderMin') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring pr-10">
              <button type="button" id="togglePassword" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
                <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
            
            <!-- Password strength indicator (4 bars) -->
            <div id="passwordStrength" class="mt-2 hidden">
              <div class="flex gap-1">
                <div id="str1" class="h-1 flex-1 rounded-full bg-border"></div>
                <div id="str2" class="h-1 flex-1 rounded-full bg-border"></div>
                <div id="str3" class="h-1 flex-1 rounded-full bg-border"></div>
                <div id="str4" class="h-1 flex-1 rounded-full bg-border"></div>
              </div>
              <p id="strengthText" class="text-xs mt-1 text-muted-foreground"></p>
            </div>
          </div>

          <!-- Confirm password input with match validation -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.confirmPasswordLabel') %></label>
            <input type="password" id="confirmPassword" required placeholder="<%= t('admin.reenterPasswordPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <p id="passwordMatch" class="text-xs mt-1 hidden"></p>
          </div>

          <!-- Role selection: GENERIC or STAFF -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.roleLabel') %></label>
            <div class="flex gap-2">
              <label class="flex-1">
                <input type="radio" name="role" value="GENERIC" class="sr-only peer" checked>
                <div class="px-4 py-2.5 border border-border rounded-lg text-center cursor-pointer text-muted-foreground peer-checked:bg-primary peer-checked:text-primary-foreground peer-checked:border-primary transition-colors text-sm font-medium">GENERIC</div>
              </label>
              <label class="flex-1">
                <input type="radio" name="role" value="STAFF" class="sr-only peer">
                <div class="px-4 py-2.5 border border-border rounded-lg text-center cursor-pointer text-muted-foreground peer-checked:bg-primary peer-checked:text-primary-foreground peer-checked:border-primary transition-colors text-sm font-medium">STAFF</div>
              </label>
            </div>
          </div>

          <!-- Submit button -->
          <button type="submit" class="w-full px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            <%= t('admin.createTutorButton') %>
          </button>
        </form>

        <!-- Recently created tutors list (shown after successful creation) -->
        <div id="recentlyCreated" class="mt-6 border-t border-border pt-4 hidden">
          <h3 class="text-sm font-medium text-muted-foreground mb-3"><%= t('admin.recentlyCreated') %></h3>
          <div id="recentList" class="space-y-2"></div>
        </div>
      </div>
    </div>

    <!-- Two-column row: Guest Accounts list | Create Guest form (separate from Tutors above) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">

      <!-- GUEST ACCOUNTS LIST -->
      <!-- Displays all GUEST-role accounts (e.g. parents/guardians) -->
      <div class="bg-card border border-border rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-foreground"><%= t('admin.guestAccountsHeading') %></h2>
          <span id="guestCount" class="text-sm text-muted-foreground"></span>
        </div>

        <!-- Search input for filtering guest accounts -->
        <div class="mb-4">
          <input type="text" id="guestSearch" placeholder="<%= t('admin.guestSearchPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring text-sm">
        </div>

        <!-- Scrollable list of guest accounts (populated by JavaScript) -->
        <div id="guestsList" class="space-y-3 max-h-[520px] overflow-y-auto pr-1">
          <!-- Guest account cards will be dynamically inserted here by admin.js -->
        </div>
      </div>

      <!-- CREATE GUEST FORM -->
      <!-- Form for creating new GUEST accounts (username, email, password) -->
      <div class="bg-card border border-border rounded-xl p-5">
        <h2 class="text-lg font-semibold text-foreground mb-4"><%= t('admin.createGuestHeading') %></h2>

        <form id="createGuestForm" class="space-y-4">
          <!-- Username input -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.usernameLabel') %></label>
            <input type="text" id="newGuestUsername" required placeholder="<%= t('admin.usernamePlaceholderGuest') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>

          <!-- Email input -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.emailLabel') %></label>
            <input type="email" id="newGuestMail" required placeholder="<%= t('admin.emailPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>

          <!-- Password input with visibility toggle -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.passwordLabel') %></label>
            <div class="relative">
              <input type="password" id="newGuestPassword" required placeholder="<%= t('admin.passwordPlaceholderMin') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring pr-10">
              <button type="button" id="toggleGuestPassword" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
                <svg id="guestEyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Confirm password input with match validation -->
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.confirmPasswordLabel') %></label>
            <input type="password" id="confirmGuestPassword" required placeholder="<%= t('admin.reenterPasswordPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <p id="guestPasswordMatch" class="text-xs mt-1 hidden"></p>
          </div>

          <!-- Submit button -->
          <button type="submit" class="w-full px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            <%= t('admin.createGuestButton') %>
          </button>
        </form>
      </div>
    </div>

    <!-- DUPLICATE STUDENTS -->
    <!-- Groups of non-erased students sharing the same name, surname, class, and
         description - likely the same student entered more than once by mistake. -->
    <div class="grid grid-cols-1 gap-6 mt-6">
      <div class="bg-card border border-border rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-foreground"><%= t('admin.duplicateStudentsHeading') %></h2>
          <span id="duplicateStudentsCount" class="text-sm text-muted-foreground"></span>
        </div>

        <div id="duplicateStudentsList" class="space-y-3">
          <!-- Duplicate group cards will be dynamically inserted here by admin.js -->
        </div>
      </div>
    </div>
  </main>

  <!-- MODALS & NOTIFICATIONS -->

  <!-- Guest Detail/Edit Modal: edit profile + assign/unassign students -->
  <div id="guestModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeGuestModal()"></div>

    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('admin.editGuestTitle') %></h2>
        <button onclick="closeGuestModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Profile edit form (username/email, plus an optional password change) -->
      <form id="editGuestForm" class="space-y-4 pb-6 border-b border-border">
        <input type="hidden" id="editGuestId">
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.usernameLabel') %></label>
          <input type="text" id="editGuestUsername" required class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.emailLabel') %></label>
          <input type="email" id="editGuestMail" required class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>

        <!-- Optional password change - leave blank to keep the current password -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.newPasswordLabel') %></label>
          <div class="relative">
            <input type="password" id="editGuestPassword" placeholder="<%= t('admin.leaveBlankPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring pr-10">
            <button type="button" id="toggleEditGuestPassword" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
              <svg id="editGuestEyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('admin.confirmNewPasswordLabel') %></label>
          <input type="password" id="confirmEditGuestPassword" placeholder="<%= t('admin.reenterNewPasswordPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          <p id="editGuestPasswordMatch" class="text-xs mt-1 hidden"></p>
        </div>

        <button type="submit" class="w-full px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
          <%= t('admin.saveChangesButton') %>
        </button>
      </form>

      <!-- Assigned students: currently linked to this guest, each removable -->
      <div class="pt-6">
        <h3 class="text-sm font-medium text-foreground mb-3"><%= t('admin.assignedStudentsHeading') %></h3>
        <div id="assignedStudentsList" class="space-y-2 mb-6">
          <!-- Assigned student rows inserted here by admin.js -->
        </div>

        <!-- Assign a student: pool mandatorily filtered to students with no guest (id_user IS NULL) -->
        <h3 class="text-sm font-medium text-foreground mb-1.5"><%= t('admin.assignStudentHeading') %></h3>
        <p class="text-xs text-muted-foreground mb-2"><%= t('admin.assignStudentHint') %></p>
        <div class="mb-2">
          <input type="text" id="assignStudentSearch" placeholder="<%= t('admin.studentSearchPlaceholder') %>" class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring text-sm">
        </div>
        <div class="flex gap-2">
          <select id="unassignedStudentsSelect" class="flex-1 px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value=""><%= t('admin.selectStudentOption') %></option>
          </select>
          <button id="assignStudentBtn" type="button" class="px-4 py-2.5 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors">
            <%= t('admin.assignButton') %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Confirmation modal for critical actions (role change, status change, etc.) -->
  <div id="confirmModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <!-- Modal backdrop - clicking this closes the modal -->
    <div class="absolute inset-0 bg-black/60" onclick="closeConfirmModal()"></div>
    
    <!-- Modal content -->
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-sm p-6">
      <div class="text-center">
        <!-- Dynamic icon, title, and message set by JavaScript -->
        <div id="confirmIcon" class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4"></div>
        <h3 id="confirmTitle" class="text-lg font-semibold text-foreground mb-2"></h3>
        <p id="confirmMessage" class="text-sm text-muted-foreground mb-6"></p>
      </div>

      <!-- Type-to-confirm row, shown only for irreversible actions (e.g. GDPR erasure) -->
      <div id="confirmTypeToConfirmRow" class="hidden mb-4">
        <label class="text-xs text-muted-foreground block mb-1"><%= t('admin.typeToConfirmPrefix') %> <strong id="confirmTypeToConfirmWord"></strong> <%= t('admin.typeToConfirmSuffix') %></label>
        <input id="confirmTypeToConfirmInput" type="text" class="w-full px-3 py-2 bg-secondary border border-border rounded-lg text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring" autocomplete="off">
      </div>

      <!-- Action buttons (Cancel and Confirm) -->
      <div class="flex gap-3">
        <button onclick="closeConfirmModal()" class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
        <button id="confirmBtn" class="flex-1 px-4 py-2.5 rounded-lg font-medium transition-colors"></button>
      </div>
    </div>
  </div>

  <!-- Toast notification container (bottom-right corner) -->
  <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2"></div>

  <script>
    // Translation dictionary for admin.js's dynamically-rendered content
    // (tutor/student/guest cards, toasts, confirm modals, etc.)
    window.translations = <%- JSON.stringify(translations) %>;
    window.lang = <%- JSON.stringify(lang) %>;
  </script>
  <!-- JavaScript for admin panel functionality (API calls, form handling, etc.) -->
  <script src="/js/theme.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
