<!--

CALENDAR PAGE

Description: Interactive calendar view for managing lessons and notes with weekly/daily views
Features:
  - Desktop week view and mobile day view
  - Add/Edit/Delete prenotations (lessons) and notes
  - Student search and selection
  - Tutor assignment for lessons and notes
  - Color-coded events (blue for lessons, orange for notes)
  - Time grid with 15-minute intervals
  - Quick navigation (Today, Previous/Next week/day)
  - Role-based features (STAFF access to Staff Panel)
  - Responsive design with mobile sidebar menu

-->

<!DOCTYPE html>
<html lang="<%= lang %>">
<!-- HEAD: Page Configuration -->
<!-- Tailwind CSS configuration with custom dark theme and calendar-specific colors -->

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tutorly - <%= t('common.calendar') %></title>
  <%- include('partials/theme-init') %>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-config') %>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/calendar.css">
  <%- include('partials/pwa-setup') %>
</head>

<body class="bg-background text-foreground min-h-screen">

  <!-- HEADER: Top Navigation Bar -->
  <!-- Logo, navigation links, action buttons (Add Prenotation/Note), and logout -->
  <header class="bg-card border-b border-border sticky top-0 z-40">
    <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo with link to home/dashboard -->
        <a href="/home" class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-foreground">Tutorly</span>
          <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
        </a>

        <!-- Desktop Navigation: Dashboard, Calendar (active), My Lessons, Staff Panel (STAFF only) -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/home" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.dashboard') %></a>
          <a href="/calendar" class="text-foreground font-medium"><%= t('common.calendar') %></a>
          <!-- GUEST accounts are restricted server-side to Dashboard/Calendar only - hide dead-end links -->
          <% if (user && user.role!=='GUEST' ) { %>
          <a href="/lessons" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.myLessons') %></a>
          <a href="/reports" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('reports.navLabel') %></a>
          <% } %>
          <!-- STAFF role-based link to Staff Panel -->
          <% if (user && user.role==='STAFF' ) { %>
            <a href="/staffPanel" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.staffPanel') %></a>
            <% } %>
        </nav>

        <!-- Action Buttons: Add Prenotation, Add Note, Logout (Desktop only) -->
        <div class="hidden md:flex items-center gap-3">
          <!-- GUEST accounts can't create anything -->
          <% if (user && user.role!=='GUEST' ) { %>
          <button id="addLessonBtn"
            class="inline-flex items-center gap-2 bg-lesson text-white px-3 py-2 rounded-lg text-sm font-medium hover:bg-lesson/90 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <%= t('calendar.prenotation') %>
          </button>
          <button id="addNoteBtn"
            class="inline-flex items-center gap-2 bg-note text-white px-3 py-2 rounded-lg text-sm font-medium hover:bg-note/90 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <%= t('calendar.note') %>
          </button>
          <% } %>
          <!-- Settings menu (theme/notifications/logout) -->
          <div class="hidden md:flex items-center gap-1">
            <%- include('partials/settings-menu') %>
          </div>
        </div>

        <!-- Mobile menu toggle button -->
        <button id="menuToggle" class="md:hidden p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- MOBILE MENU: Overlay and Sidebar -->
  <!-- Overlay backdrop for mobile menu -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Mobile Sidebar: Navigation links, action buttons, and logout -->
  <aside id="mobileMenu"
    class="mobile-menu fixed top-0 left-0 h-full w-72 bg-card border-r border-border z-50 md:hidden">
    <div class="p-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
        </div>
        <span class="text-lg font-bold text-foreground">Tutorly</span>
        <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
      </div>
      <button id="closeMenu" class="p-2 rounded-lg hover:bg-secondary transition-colors">
        <svg class="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="p-4 flex flex-col gap-2">
      <a href="/home"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <%= t('common.dashboard') %>
      </a>
      <a href="/calendar" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-secondary text-foreground">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <%= t('common.calendar') %>
      </a>
      <!-- GUEST accounts are restricted server-side to Dashboard/Calendar only - hide dead-end links -->
      <% if (user && user.role!=='GUEST' ) { %>
      <a href="/lessons"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <%= t('common.myLessons') %>
      </a>
      <a href="/reports"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <%= t('reports.navLabel') %>
      </a>
      <% } %>
      <!-- STAFF role-based link in mobile menu -->
      <% if (user && user.role==='STAFF' ) { %>
        <a href="/staffPanel"
          class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <%= t('common.staffPanel') %>
        </a>
        <% } %>
    </nav>

    <!-- Mobile Action Buttons: Add Prenotation, Add Note, Logout -->
    <div class="p-4 border-t border-border mt-auto">
      <div class="flex flex-col gap-2">
        <!-- GUEST accounts can't create anything -->
        <% if (user && user.role!=='GUEST' ) { %>
        <button onclick="openLessonModal()"
          class="flex items-center justify-center gap-2 bg-lesson text-white px-4 py-2.5 rounded-lg font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <%= t('calendar.addPrenotation') %>
        </button>
        <button onclick="openNoteModal()"
          class="flex items-center justify-center gap-2 bg-note text-white px-4 py-2.5 rounded-lg font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <%= t('calendar.addNote') %>
        </button>
        <% } %>
        <%- include('partials/settings-menu-mobile') %>
      </div>
    </div>
  </aside>

  <!-- MAIN CONTENT: Calendar Display -->
  <main class="flex flex-col h-[calc(100vh-64px)]">

    <!-- Calendar Header: Today button, week navigation, date label, and event legend -->
    <div class="bg-card border-b border-border px-4 sm:px-6 py-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
          <button id="todayBtn"
            class="px-3 py-1.5 border border-border rounded-lg text-sm font-medium text-foreground hover:bg-secondary transition-colors">
            <%= t('calendar.today') %>
          </button>
          <!-- Week navigation is only meaningful for the desktop week view; the mobile
               day view has its own prevDay/nextDay controls, so hide this below md -->
          <div class="hidden md:flex items-center gap-1">
            <button id="prevWeek" class="p-1.5 rounded-lg hover:bg-secondary transition-colors">
              <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button id="nextWeek" class="p-1.5 rounded-lg hover:bg-secondary transition-colors">
              <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
          <h2 id="currentWeekLabel" class="hidden md:block text-lg font-semibold text-foreground"></h2>
        </div>

        <div class="flex items-center gap-4">
          <!-- Tutor filter (STAFF only): shows only the selected tutor's prenotations.
               Custom dropdown (not a native <select>) so each row can show a small
               swatch in that tutor's prenotation color next to their name in plain
               white text - <option> elements can't mix a colored icon with
               separately-colored text. -->
          <% if (user && user.role==='STAFF' ) { %>
            <div class="flex items-center gap-2 relative">
              <span class="text-sm text-muted-foreground"><%= t('calendar.tutor') %></span>
              <button type="button" id="tutorFilterBtn"
                class="flex items-center gap-2 px-2 py-1.5 bg-secondary border border-border rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-ring">
                <span id="tutorFilterSwatch" class="w-2.5 h-2.5 rounded-sm hidden"></span>
                <span id="tutorFilterLabel"><%= t('calendar.allTutors') %></span>
                <svg class="w-3 h-3 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="tutorFilterMenu"
                class="hidden absolute top-full left-0 mt-1 z-30 w-48 max-h-64 overflow-y-auto bg-card border border-border rounded-lg shadow-lg py-1">
              </div>
            </div>
            <% } %>

              <!-- Color legend for event types (own prenotation = blue, own note = orange, note assigned by someone else = red) -->
              <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-sm bg-lesson"></span>
                  <span class="text-sm text-muted-foreground"><%= t('calendar.prenotation') %></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-sm bg-note"></span>
                  <span class="text-sm text-muted-foreground"><%= t('calendar.note') %></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-sm bg-destructive"></span>
                  <span class="text-sm text-muted-foreground"><%= t('calendar.assignedNote') %></span>
                </div>
              </div>
        </div>
      </div>
    </div>

    <!-- Calendar View: Desktop week grid and mobile day view -->
    <div id="calendarScrollContainer" class="flex-1 overflow-auto custom-scrollbar">

      <!-- Desktop Week View: 7-day grid with time slots from 8:00 to 22:00 -->
      <div id="weekView" class="hidden md:block min-w-[800px]">
        <!-- Sticky header: day-of-week labels + all-day notes row stay pinned together
             while scrolling the hourly grid below -->
        <div class="sticky top-0 z-20 bg-card border-b border-border">
          <!-- Day Headers: Column headers for each day of the week -->
          <div class="calendar-grid">
            <div class="p-2 text-center text-xs text-muted-foreground"></div>
            <div id="dayHeaders" class="contents">
              <!-- Day headers will be rendered here -->
            </div>
          </div>

          <!-- All-Day Notes Row: notes spanning a full day, shown here instead of stretched
               across the hourly grid below. Hidden when the visible week has none. -->
          <div class="calendar-grid border-t border-border hidden" id="allDayRow">
            <div class="p-1 text-center text-[10px] text-muted-foreground"><%= t('calendar.allDay') %></div>
            <div id="allDayNotesContainer" class="contents">
              <!-- All-day note chips will be rendered here -->
            </div>
          </div>
        </div>

        <!-- Time Grid: Hourly rows with event blocks positioned by time -->
        <div class="calendar-grid" id="timeGrid">
          <!-- Time slots and events will be rendered here -->
        </div>
      </div>

      <!-- Mobile Day View: Single day with time slots and date navigation -->
      <div id="dayView" class="md:hidden">
        <!-- Sticky header: date navigation + quick actions stay pinned together while scrolling
             (the grid auto-scrolls to 8:00 on open - without sticky, non-fixed content above the
             grid would immediately scroll out of view) -->
        <div class="sticky top-0 z-20 bg-card border-b border-border">
          <!-- Mobile Date Selector: Navigation arrows and current date display -->
          <div class="flex items-center justify-between px-4 py-3">
            <button id="prevDay" class="p-2 rounded-lg hover:bg-secondary transition-colors">
              <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <div class="text-center">
              <p id="mobileDateLabel" class="font-semibold text-foreground"></p>
              <p id="mobileDayLabel" class="text-sm text-muted-foreground"></p>
            </div>
            <button id="nextDay" class="p-2 rounded-lg hover:bg-secondary transition-colors">
              <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Mobile Quick Actions: Add Prenotation / Add Note, visible directly on the page -->
          <!-- GUEST accounts can't create anything -->
          <% if (user && user.role!=='GUEST' ) { %>
          <div class="flex items-center gap-2 px-4 py-2 border-t border-border">
            <button onclick="openLessonModal()"
              class="flex-1 inline-flex items-center justify-center gap-2 bg-lesson text-white px-3 py-2 rounded-lg text-sm font-medium hover:bg-lesson/90 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <%= t('calendar.prenotation') %>
            </button>
            <button onclick="openNoteModal()"
              class="flex-1 inline-flex items-center justify-center gap-2 bg-note text-white px-3 py-2 rounded-lg text-sm font-medium hover:bg-note/90 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <%= t('calendar.note') %>
            </button>
          </div>
          <% } %>

          <!-- All-Day Notes: notes spanning the full viewed day, shown here instead of
               stretched across the hourly grid below. Hidden when the day has none. -->
          <div class="px-4 py-2 border-t border-border space-y-1 hidden" id="mobileAllDayRow">
            <!-- All-day note chips will be rendered here -->
          </div>
        </div>

        <!-- Mobile Time Grid: Single-column time slots for selected day -->
        <div id="mobileTimeGrid" class="calendar-grid">
          <!-- Mobile time slots will be rendered here -->
        </div>
      </div>
    </div>
  </main>

  <!-- MODALS: Add/Edit Dialogs -->
  <!-- Slot Choice Modal: Ask whether a clicked calendar time slot should become a Prenotation or a Note -->
  <div id="slotChoiceModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeSlotChoiceModal()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('calendar.addToCalendar') %></h2>
        <button onclick="closeSlotChoiceModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <p class="text-sm text-muted-foreground mb-4"><%= t('calendar.addToCalendarPrompt') %></p>

      <div class="flex flex-col gap-3">
        <button onclick="chooseSlotOption('lesson')"
          class="w-full flex items-center justify-center gap-2 bg-lesson text-white px-4 py-3 rounded-lg font-medium hover:bg-lesson/90 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <%= t('calendar.prenotation') %>
        </button>
        <button onclick="chooseSlotOption('note')"
          class="w-full flex items-center justify-center gap-2 bg-note text-white px-4 py-3 rounded-lg font-medium hover:bg-note/90 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <%= t('calendar.note') %>
        </button>
      </div>
    </div>
  </div>

  <!-- Add Lesson Modal: Form to create new prenotation with student selection and time -->
  <div id="addLessonModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeLessonModal()"></div>
    <div
      class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('calendar.addNewPrenotation') %></h2>
        <button onclick="closeLessonModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form with student search/select, date/time pickers, and tutor assignment -->
      <form id="lessonForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.searchStudent') %></label>
          <input type="text" id="studentSearch" placeholder="<%= t('common.searchByName') %>"
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            autocomplete="off">
        </div>

        <!-- Student selection dropdown with option to add new student -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-sm font-medium text-foreground"><%= t('common.selectStudent') %></label>
            <button type="button" onclick="openAddStudentModal()"
              class="text-xs text-primary hover:underline flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <%= t('common.addNewStudent') %>
            </button>
          </div>
          <select id="studentSelect" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value=""><%= t('common.selectAStudentOption') %></option>
          </select>
        </div>

        <!-- Date picker for lesson -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.date') %></label>
          <input type="date" id="lessonDate" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>

        <!-- Start and End time pickers (15-minute intervals) -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.startTime') %></label>
            <input type="time" id="lessonStartTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.endTime') %></label>
            <input type="time" id="lessonEndTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <!-- Repeat Weekly: creates one prenotation per week, same day/time, until the end date -->
        <div class="flex items-center gap-2">
          <input type="checkbox" id="lessonRepeat"
            class="w-4 h-4 rounded border-border text-primary focus:outline-none focus:ring-2 focus:ring-ring">
          <label for="lessonRepeat" class="text-sm font-medium text-foreground"><%= t('calendar.repeatWeekly') %></label>
        </div>

        <div class="grid grid-cols-2 gap-4 hidden" id="lessonRepeatFields">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('calendar.repeatFrom') %></label>
            <input type="date" id="lessonRepeatFrom"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('calendar.repeatUntil') %></label>
            <input type="date" id="lessonRepeatUntil"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <!-- Tutor assignment section with quick 'assign to myself' option -->
        <div id="lessonAssignToSection">
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-sm font-medium text-foreground"><%= t('common.assignTo') %></label>
            <button type="button" onclick="assignLessonToMyself()" class="text-xs text-primary hover:underline"><%= t('common.assignToMyself') %></button>
          </div>
          <div id="lessonTutorsContainer"
            class="bg-secondary border border-border rounded-lg p-2 max-h-40 overflow-y-auto space-y-1">
            <!-- Tutor checkboxes will be loaded dynamically from server data -->
          </div>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="button" onclick="closeLessonModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-lesson text-white rounded-lg font-medium hover:bg-lesson/90 transition-colors"><%= t('calendar.addPrenotation') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Note Modal: Form to create new calendar note with description and time -->
  <div id="addNoteModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeNoteModal()"></div>
    <div
      class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('calendar.addNewNote') %></h2>
        <button onclick="closeNoteModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form with description, date/time pickers, and tutor assignment -->
      <form id="noteForm" class="space-y-4">
        <!-- Note description textarea -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.description') %></label>
          <textarea id="noteDescription" required placeholder="<%= t('calendar.noteDescriptionPlaceholder') %>" rows="3"
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"></textarea>
        </div>

        <!-- Date range: creates the same note on every day from start to end (inclusive) -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.startDate') %></label>
            <input type="date" id="noteStartDate" required
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.endDate') %></label>
            <input type="date" id="noteEndDate" required
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>
        <p class="text-xs text-muted-foreground -mt-2"><%= t('calendar.noteRangeHint') %></p>

        <!-- All Day: when checked, skips manual times and takes each selected day in full -->
        <div class="flex items-center gap-2">
          <input type="checkbox" id="noteAllDay"
            class="w-4 h-4 rounded border-border text-primary focus:outline-none focus:ring-2 focus:ring-ring">
          <label for="noteAllDay" class="text-sm font-medium text-foreground"><%= t('calendar.allDay') %></label>
        </div>

        <!-- Start Time applies on Start Date, End Time applies on End Date - together they
             define one continuous note (e.g. Mon 14:00 to Wed 10:00 spans all three days) -->
        <div class="grid grid-cols-2 gap-4" id="noteTimeFields">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.startTime') %></label>
            <input type="time" id="noteStartTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.endTime') %></label>
            <input type="time" id="noteEndTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <!-- Tutor assignment section with quick 'assign to myself' option -->
        <div id="assignToSection">
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-sm font-medium text-foreground"><%= t('common.assignTo') %></label>
            <button type="button" onclick="assignToMyself()" class="text-xs text-primary hover:underline"><%= t('common.assignToMyself') %></button>
          </div>
          <div id="assigneesContainer"
            class="bg-secondary border border-border rounded-lg p-2 max-h-40 overflow-y-auto space-y-1">
            <!-- Tutor checkboxes will be loaded dynamically from server data -->
          </div>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="button" onclick="closeNoteModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-note text-white rounded-lg font-medium hover:bg-note/90 transition-colors"><%= t('calendar.addNote') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Student Modal: Quick form to add new student (higher z-index to overlay lesson modal) -->
  <div id="addStudentModal" class="modal fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeAddStudentModal()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('common.addNewStudent') %></h2>
        <button onclick="closeAddStudentModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form with first name, last name, class selection, and optional description -->
      <form id="addStudentForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.firstName') %></label>
          <input type="text" id="studentName" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.lastName') %></label>
          <input type="text" id="studentSurname" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>

        <!-- Class selection: M (Media/Middle School), S (Superiore/High School), U (Università/University) -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.class') %></label>
          <select id="studentClass" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value=""><%= t('common.selectClassOption') %></option>
            <option value="M"><%= t('common.classMiddle') %></option>
            <option value="S"><%= t('common.classHigh') %></option>
            <option value="U"><%= t('common.classUniversity') %></option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.descriptionOptional') %></label>
          <textarea id="studentDescription" rows="3"
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"></textarea>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="button" onclick="closeAddStudentModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors"><%= t('common.addStudent') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Prenotation Modal: Form to modify existing lesson or delete it -->
  <div id="editPrenotationModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeEditPrenotationModal()"></div>
    <div
      class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('calendar.editPrenotation') %></h2>
        <button onclick="closeEditPrenotationModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form with hidden ID field, student search/select, date/time pickers, tutor assignment, and delete option -->
      <form id="editPrenotationForm" class="space-y-4">
        <input type="hidden" id="editPrenotationId">

        <!-- Student search field with autocomplete filtering -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.searchStudent') %></label>
          <input type="text" id="editStudentSearch" placeholder="<%= t('common.searchByName') %>"
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            autocomplete="off">
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.selectStudent') %></label>
          <select id="editStudentSelect" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value=""><%= t('common.selectAStudentOption') %></option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.date') %></label>
          <input type="date" id="editPrenotationDate" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.startTime') %></label>
            <input type="time" id="editPrenotationStartTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.endTime') %></label>
            <input type="time" id="editPrenotationEndTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <!-- Tutor assignment section for editing -->
        <div id="editPrenotationAssignToSection">
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.assignTo') %></label>
          <div id="editPrenotationTutorsContainer"
            class="bg-secondary border border-border rounded-lg p-2 max-h-40 overflow-y-auto space-y-1">
            <!-- Tutor checkboxes will be loaded dynamically -->
          </div>
        </div>

        <!-- Action buttons: Delete, Cancel, Update -->
        <div class="flex gap-3 pt-4">
          <button type="button" onclick="deletePrenotation()"
            class="px-4 py-2.5 bg-destructive text-white rounded-lg font-medium hover:bg-destructive/90 transition-colors"><%= t('common.delete') %></button>
          <button type="button" onclick="closeEditPrenotationModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-lesson text-white rounded-lg font-medium hover:bg-lesson/90 transition-colors"><%= t('common.update') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Note Modal: Form to modify existing note or delete it -->
  <div id="editNoteModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeEditNoteModal()"></div>
    <div
      class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground"><%= t('calendar.editNote') %></h2>
        <button onclick="closeEditNoteModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form with hidden ID field, description, date/time pickers, tutor assignment, and delete option -->
      <form id="editNoteForm" class="space-y-4">
        <input type="hidden" id="editNoteId">

        <!-- Note description textarea -->
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.description') %></label>
          <textarea id="editNoteDescription" required placeholder="<%= t('calendar.noteDescriptionPlaceholder') %>" rows="3"
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"></textarea>
        </div>

        <!-- Date range: same date in both fields for a single-day note, or a range for
             one continuous note spanning multiple days (see Add Note for details) -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.startDate') %></label>
            <input type="date" id="editNoteStartDate" required
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.endDate') %></label>
            <input type="date" id="editNoteEndDate" required
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <!-- All Day: when checked, skips manual times and takes each selected day in full -->
        <div class="flex items-center gap-2">
          <input type="checkbox" id="editNoteAllDay"
            class="w-4 h-4 rounded border-border text-primary focus:outline-none focus:ring-2 focus:ring-ring">
          <label for="editNoteAllDay" class="text-sm font-medium text-foreground"><%= t('calendar.allDay') %></label>
        </div>

        <div class="grid grid-cols-2 gap-4" id="editNoteTimeFields">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.startTime') %></label>
            <input type="time" id="editNoteStartTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.endTime') %></label>
            <input type="time" id="editNoteEndTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>

        <!-- Tutor assignment section for editing -->
        <div id="editNoteAssignToSection">
          <label class="block text-sm font-medium text-foreground mb-1.5"><%= t('common.assignTo') %></label>
          <div id="editNoteAssigneesContainer"
            class="bg-secondary border border-border rounded-lg p-2 max-h-40 overflow-y-auto space-y-1">
            <!-- Tutor checkboxes will be loaded dynamically -->
          </div>
        </div>

        <!-- Action buttons: Delete, Cancel, Update -->
        <div class="flex gap-3 pt-4">
          <button type="button" onclick="deleteNote()"
            class="px-4 py-2.5 bg-destructive text-white rounded-lg font-medium hover:bg-destructive/90 transition-colors"><%= t('common.delete') %></button>
          <button type="button" onclick="closeEditNoteModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors"><%= t('common.cancel') %></button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-note text-white rounded-lg font-medium hover:bg-note/90 transition-colors"><%= t('common.update') %></button>
        </div>
      </form>
    </div>
  </div>

  <!-- SCRIPTS: Data and Functionality -->
  <!-- Server-side data injection: prenotations, notes, students, tutors, user info -->
  <script>
    // Pass server-side data to JavaScript for client-side rendering
    window.serverData = {
      prenotations: <%- JSON.stringify(prenotations) %>,
      calendarNotes: <%- JSON.stringify(calendarNotes) %>,
      students: <%- JSON.stringify(students) %>,
      tutors: <%- JSON.stringify(tutors) %>,
      currentUserId: <%= userId %>,
      userRole: '<%= user.role %>'
    };
    window.translations = <%- JSON.stringify(translations) %>;
    window.lang = <%- JSON.stringify(lang) %>;
  </script>
  <script src="/js/theme.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="/js/settingsMenu.js"></script>
  <script src="/js/push.js"></script>
  <!-- JavaScript for calendar rendering, event management, and modal interactions -->
  <script src="/js/calendarScript.js"></script>
</body>

</html>