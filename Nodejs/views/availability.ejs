<!--

AVAILABILITY PAGE

Description: Browse tutors' weekly availability schedules and find an open time slot.
Data: real - every active GENERIC/STAFF tutor's recurring weekly availability
(`availability` table) plus STAFF-approved one-off exceptions (`exception_day` table),
fetched and shaped server-side into window.initialTutors - see GET /availability in
src/index.js and public/js/availability.js.
GENERIC and STAFF only - see GET /availability in src/index.js.

-->

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tutorly - <%= t('common.availability') %></title>
  <%- include('partials/theme-init') %>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-config') %>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/availability.css">
  <%- include('partials/pwa-setup') %>
</head>

<body class="bg-background text-foreground min-h-screen">

  <!-- HEADER: Top Navigation Bar (same structure as home/calendar/lessons/reports/staffPanel) -->
  <header class="bg-card border-b border-border sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo with link to home/dashboard -->
        <a href="/home" class="flex items-center gap-2">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-foreground">Tutorly</span>
          <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
        </a>

        <!-- Desktop Navigation: Dashboard, Calendar, Availability (active), My Lessons, Reports, Staff Panel (STAFF only) -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/home" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.dashboard') %></a>
          <a href="/calendar" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.calendar') %></a>
          <a href="/availability" class="text-foreground font-medium"><%= t('common.availability') %></a>
          <a href="/lessons" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.myLessons') %></a>
          <a href="/reports" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('reports.navLabel') %></a>
          <!-- STAFF role-based link to Staff Panel -->
          <% if (user && user.role==='STAFF' ) { %>
            <a href="/staffPanel" class="text-muted-foreground hover:text-foreground transition-colors"><%= t('common.staffPanel') %></a>
            <% } %>
        </nav>

        <!-- Settings menu (theme/notifications/logout) button (Desktop) -->
        <div class="hidden md:flex items-center gap-1">
          <%- include('partials/settings-menu') %>
        </div>

        <!-- Mobile hamburger menu toggle button -->
        <button id="menuToggle" class="md:hidden p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- MOBILE MENU: Overlay and Sidebar -->
  <div id="menuOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <aside id="mobileMenu"
    class="mobile-menu fixed top-0 left-0 h-full w-72 bg-card border-r border-border z-50 md:hidden">
    <div class="p-4 border-b border-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
        </div>
        <span class="text-lg font-bold text-foreground">Tutorly</span>
        <% if (poweredByText) { %><span class="text-xs text-muted-foreground ml-1"><%= poweredByText %></span><% } %>
      </div>
      <button id="closeMenu" class="p-2 rounded-lg hover:bg-secondary transition-colors">
        <svg class="w-5 h-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="p-4 flex flex-col gap-2">
      <a href="/home"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <%= t('common.dashboard') %>
      </a>
      <a href="/calendar"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <%= t('common.calendar') %>
      </a>
      <a href="/availability" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-secondary text-foreground">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <%= t('common.availability') %>
      </a>
      <a href="/lessons"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <%= t('common.myLessons') %>
      </a>
      <a href="/reports"
        class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <%= t('reports.navLabel') %>
      </a>
      <!-- STAFF role-based link in mobile menu -->
      <% if (user && user.role==='STAFF' ) { %>
        <a href="/staffPanel"
          class="flex items-center gap-3 px-4 py-3 rounded-lg text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <%= t('common.staffPanel') %>
        </a>
        <% } %>
          <!-- Settings (theme/notifications/logout) in mobile menu -->
          <div class="mt-4 pt-4 border-t border-border space-y-1">
            <%- include('partials/settings-menu-mobile') %>
          </div>
    </nav>
  </aside>

  <!-- MAIN CONTENT: Tutor Availability -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6">

    <section class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-medium uppercase tracking-[.16em] text-primary">Tutor schedule</p>
        <h1 class="mt-1 text-2xl sm:text-3xl font-bold text-foreground"><%= t('common.availability') %></h1>
        <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Browse weekly schedules and find an open time with the right tutor.</p>
      </div>
      <div class="rounded-full border border-border bg-card px-3 py-1.5 text-xs text-muted-foreground">
        <span class="mr-2 inline-block h-2 w-2 rounded-full bg-primary"></span>Available time
      </div>
    </section>

    <!-- Action buttons: Add Availability (STAFF only), Add Exception - Present/Absent (STAFF + GENERIC) -->
    <section class="flex flex-wrap gap-3">
      <% if (user && user.role === 'STAFF') { %>
      <button id="addAvailabilityBtn" type="button"
        class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2.5 rounded-lg font-medium hover:bg-primary/90 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Availability
      </button>
      <% } %>
      <button id="addPresentExceptionBtn" type="button"
        class="inline-flex items-center gap-2 bg-green-600 text-white px-4 py-2.5 rounded-lg font-medium hover:bg-green-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Presence
      </button>
      <button id="addAbsentExceptionBtn" type="button"
        class="inline-flex items-center gap-2 bg-destructive text-white px-4 py-2.5 rounded-lg font-medium hover:bg-destructive/90 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Absence
      </button>
    </section>

    <section aria-labelledby="all-tutors-heading" class="space-y-3">
      <h2 id="all-tutors-heading" class="text-lg font-semibold text-foreground">All Tutors</h2>
      <div id="tutorList" class="flex flex-wrap gap-2" aria-live="polite"></div>
    </section>

    <section aria-labelledby="weekly-list-heading" class="space-y-4">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="weekly-list-heading" class="text-lg font-semibold text-foreground">Available tutors by day</h2>
          <p class="mt-1 text-sm text-muted-foreground">For the week selected below - including any approved exceptions. Select a tutor to view their full week.</p>
        </div>
        <p id="tutorCount" class="text-sm text-muted-foreground"></p>
      </div>
      <div id="dayList" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-live="polite"></div>
    </section>

    <section aria-labelledby="week-heading" class="overflow-hidden rounded-xl border border-border bg-card">
      <div class="flex flex-col gap-4 border-b border-border p-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
        <div>
          <p class="text-sm text-muted-foreground">Selected tutor</p>
          <h2 id="week-heading" class="mt-0.5 text-lg font-semibold text-foreground">Weekly availability</h2>
          <p id="selectedTutorLabel" class="text-sm text-primary"></p>
        </div>
        <div class="flex items-center justify-between gap-3 sm:justify-end">
          <button id="todayButton" class="rounded-lg border border-border px-3 py-2 text-sm font-medium text-foreground hover:bg-secondary transition-colors">This week</button>
          <div class="flex items-center gap-1">
            <button id="prevWeek" class="rounded-lg p-2 text-foreground hover:bg-secondary transition-colors" aria-label="Previous week">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <button id="nextWeek" class="rounded-lg p-2 text-foreground hover:bg-secondary transition-colors" aria-label="Next week">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
          <p id="weekLabel" class="min-w-[116px] text-right text-sm font-medium text-foreground"></p>
        </div>
      </div>
      <div class="p-4 sm:p-5">
        <div class="mb-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground">
          <span class="inline-flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-sm bg-primary"></i>Available</span>
          <span>Times shown in local time</span>
        </div>
        <div id="desktopWeek" class="desktop-week week-grid overflow-hidden rounded-xl border border-border"></div>
        <div id="mobileWeek" class="mobile-week space-y-2"></div>
      </div>
    </section>
  </main>

  <!-- MODALS -->
  <!-- Add Availability Modal (STAFF only) -->
  <div id="addAvailabilityModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeAddAvailabilityModal()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-foreground">Add Availability</h2>
        <button onclick="closeAddAvailabilityModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="addAvailabilityForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Tutor</label>
          <select id="availabilityTutor" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value="">-- Select a tutor --</option>
            <% tutors.forEach(tutor => { %>
            <option value="<%= tutor.id %>"><%= tutor.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Day of week</label>
          <select id="availabilityWeekDay" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
            <option value="7">Sunday</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">Start time</label>
            <input type="time" id="availabilityStartTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">End time</label>
            <input type="time" id="availabilityEndTime" required step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeAddAvailabilityModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors">Cancel</button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">Add</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Exception Modal (STAFF + GENERIC) - shared by both the "Present" and
       "Absent" buttons; openAddExceptionModal(type) sets the hidden type field,
       toggles the time fields, and updates the title -->
  <div id="addExceptionModal" class="modal fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60" onclick="closeAddExceptionModal()"></div>
    <div class="modal-content relative bg-card border border-border rounded-xl w-full max-w-md p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 id="addExceptionModalTitle" class="text-xl font-semibold text-foreground">Add Exception</h2>
        <button onclick="closeAddExceptionModal()" class="p-2 rounded-lg hover:bg-secondary transition-colors">
          <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="addExceptionForm" class="space-y-4">
        <input type="hidden" id="exceptionType">
        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Date</label>
          <input type="date" id="exceptionDay" required
            class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>
        <div id="exceptionTimeFields" class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">Start time</label>
            <input type="time" id="exceptionStartTime" step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">End time</label>
            <input type="time" id="exceptionEndTime" step="900"
              class="w-full px-3 py-2.5 bg-secondary border border-border rounded-lg text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
          </div>
        </div>
        <p class="text-xs text-muted-foreground">Submitted as a request - a STAFF member needs to approve it before it affects your schedule.</p>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeAddExceptionModal()"
            class="flex-1 px-4 py-2.5 border border-border rounded-lg text-foreground hover:bg-secondary transition-colors">Cancel</button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">Submit</button>
        </div>
      </form>
    </div>
  </div>

  <!-- SCRIPTS -->
  <script>
    // Active GENERIC/STAFF tutors, with their recurring weekly availability
    // (availability table) and STAFF-approved one-off exceptions (exception_day
    // table) - see GET /availability in src/index.js
    window.initialTutors = <%- JSON.stringify(tutors) %>;
    window.userRole = <%- JSON.stringify(user && user.role) %>;
    window.translations = <%- JSON.stringify(translations) %>;
    window.lang = <%- JSON.stringify(lang) %>;
  </script>
  <script src="/js/theme.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="/js/settingsMenu.js"></script>
  <script src="/js/push.js"></script>
  <script src="/js/availability.js"></script>
</body>

</html>
