#-------------------------------------------------------------------------------------
# Tutorly - Environment Variables Configuration
#-------------------------------------------------------------------------------------
#
# This is an example configuration file for environment variables.
# Copy this file to .env and update the values as needed.
#
# Usage:
#   cp .env.example .env
#
# Note: The .env file is ignored by Git to keep sensitive data secure.
#
#-------------------------------------------------------------------------------------

# Server Configuration
#-------------------------------------------------------------------------------------

# HTTP server port (default: 3000)
PORT=3000

# HTTPS server port (default: 3443)
HTTPS_PORT=3443

# Enable HTTPS mode (true/false)
# Set to 'true' to enable HTTPS with self-signed certificates
# Requires SSL certificates in ssl/ directory (run: npm run generate-cert)
USE_HTTPS=false


# SSL Certificate Paths
#-------------------------------------------------------------------------------------

# Path to SSL private key (relative to project root)
SSL_KEY_PATH=./ssl/private-key.pem

# Path to SSL certificate (relative to project root)
SSL_CERT_PATH=./ssl/certificate.pem


# Java Backend API Configuration
#-------------------------------------------------------------------------------------

# Base URL for Java Spring Boot backend API
JAVA_API_URL=https://localhost:8443

# API key for authenticating requests to Java backend
# WARNING: Change this value in production!
JAVA_API_KEY=MLkOj0KWeVxppf7sJifwRS3gwukG0Mhu


# Session Configuration
#-------------------------------------------------------------------------------------

# Secret key for signing tutor session cookies
# WARNING: Change this value in production!
TUTOR_SESSION_SECRET=tutorly-tutor-secret-key-change-in-production

# Secret key for signing admin session cookies
# WARNING: Change this value in production!
ADMIN_SESSION_SECRET=tutorly-admin-secret-key-change-in-production


# Branding Configuration
#-------------------------------------------------------------------------------------

# Tagline shown next to the Tutorly logo in the header of every page.
# Set to an empty value to hide it.
POWERED_BY_TEXT=Powered by Tutorly


# Web Push (VAPID) Configuration
#-------------------------------------------------------------------------------------

# Generate a keypair once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Push notifications are disabled (no-op) if these are left unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI included in the VAPID JWT (mailto: or https:) so push services
# can reach you if a subscription is ever flagged as abusive.
VAPID_SUBJECT=mailto:admin@example.com


# Daily Reminder Notifications
#-------------------------------------------------------------------------------------

# Local time of day (24h "HH:MM") the daily reminder job sends a push for every
# prenotation/calendar note starting that day.
REMINDER_TIME=07:00

# IANA timezone REMINDER_TIME is evaluated in - independent of the server's own OS timezone.
TIMEZONE=Europe/Rome


# Development Configuration
#-------------------------------------------------------------------------------------

# Node environment (development/production)
NODE_ENV=development
